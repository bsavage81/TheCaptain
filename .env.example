# Bootstrap secrets only. Operational settings are in botdata.settings_json, row 1.
# Existing deployment key names are retained. Never commit real values.
token=
database_ip=127.0.0.1
database_port=3306
database_username=
database_password=
database_schema=your_existing_captain_schema
# Owner-approved self-signed provider certificate; transport is still required to be encrypted.
# Use verify_identity with a provider CA when available.
database_ssl_mode=self_signed
# Optional provider CA certificate path, relative to the repository root:
# database_ssl_ca=provider-ca.pem

# Optional Coastal Craft Apps Script portal; leave all three blank for Discord modals.
# Keep the shared secret private. Use the published /exec web app URL, never the editor URL.
# The deployed Coastal form URL/inbox are defaults when only the secret is configured.
APPLICATION_WEB_URL=
APPLICATION_WEB_SECRET=
APPLICATION_INBOX_ID=
